{
  "name": "vlinde/laravel-bugster",
  "description": "A Laravel Nova tool.",
  "keywords": [
    "laravel",
    "nova"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/nova": "^5.0",
    "laravel/nova-devtool": "^1.7"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Vlinde\\Bugster\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vlinde\\Bugster\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
